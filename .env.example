# Copy this file to .env and fill in your key:
#   cp .env.example .env

# Required: your Anthropic API key (CrewAI reaches Claude through LiteLLM).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the agents use.
# Defaults to Claude Opus 4.8. While learning you may want a cheaper/faster
# model for the many LLM calls a crew makes — e.g.:
#   anthropic/claude-sonnet-4-6   (cheaper, fast)
#   anthropic/claude-haiku-4-5    (cheapest)
# TRIPWEAVER_MODEL=anthropic/claude-opus-4-8

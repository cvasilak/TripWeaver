# Copy this file to .env and fill in your key:
#   cp .env.example .env

# Required: your Anthropic API key (CrewAI reaches Claude through LiteLLM).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the agents use.
# Defaults to Claude Sonnet 4.5 (the latest Sonnet CrewAI routes through
# Anthropic's native structured-outputs path). Other allow-listed models, so
# structured output stays reliable:
#   anthropic/claude-opus-4-5     (stronger, pricier)
#   anthropic/claude-haiku-4-5    (cheapest)
# TRIPWEAVER_MODEL=anthropic/claude-sonnet-4-5
